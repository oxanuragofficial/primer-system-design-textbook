digraph G { rankdir=LR; nodesep=0.2; ranksep=0.28; node [shape=box fontsize=9.5];
a [label="1 Expand\nadd new column;\nwrite both"]; b [label="2 Backfill\ncopy old data\nin small batches" ]; c [label="3 Switch reads\nread new column\n(fallback to old)"]; d [label="4 Contract\nstop old writes;\ndrop old column" fillcolor="#d5e7ef"];
a->b->c->d; }
