digraph G { rankdir=TB; nodesep=0.14; ranksep=0.22; node [fontsize=9 margin="0.07,0.05"];
u [label="User" shape=ellipse fillcolor="#ffffff"]; api [label="Accounts &\nDashboard API"]; sc [label="Scheduler"]; q [label="Refresh\nqueue" shape=cds]; w [label="Extraction\nworkers"]; ag [label="Aggregator\n(bank access)" fillcolor="#ffffff" shape=box style="dashed,rounded"]; st [label="Event\nstream" shape=cds]; pl [label="Transaction\npipeline" fillcolor="#d5e7ef"]; tx [label="Transactions\n(sharded)" shape=cylinder]; sm [label="Monthly\nsummaries" shape=cylinder]; be [label="Budget\nevaluator"]; nt [label="Notifier"];
u->api; api->sc; sc->q->w; w->ag [dir=both]; w->st->pl; pl->tx; pl->sm; st->be->nt; api->sm [style=dashed label="reads"]; }
