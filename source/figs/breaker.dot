digraph G { rankdir=LR; nodesep=0.3; ranksep=0.6; node [shape=ellipse fontsize=10];
c [label="CLOSED\ncalls pass;\nfailures counted" fillcolor="#e3f1ea"]; o [label="OPEN\nfail fast for\ncool-down" fillcolor="#FBF0EC" color="#b4492f"]; h [label="HALF-OPEN\na few trial calls" fillcolor="#FFF8E6"];
c->o [label="failures\nabove limit"]; o->h [label="cool-down\nends"]; h->c [label="trials\nsucceed"]; h->o [label="a trial\nfails" color="#b4492f" fontcolor="#b4492f"]; }
